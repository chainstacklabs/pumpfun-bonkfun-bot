# Keep this template unfunded and out of source control after copying to .env.
# Use a dedicated, low-value wallet only. Never enter a seed phrase.
# Checked-in bot samples are disabled and explicitly use execution.mode=dry_run;
# a private key does not authorize live submission without the separate live gates.
SOLANA_NODE_RPC_ENDPOINT=...
SOLANA_NODE_WSS_ENDPOINT=...

GEYSER_ENDPOINT=
GEYSER_API_TOKEN=
# Geyser auth type must be exactly "x-token" or "basic".
GEYSER_AUTH_TYPE=x-token

# Base58 private key for the dedicated bot wallet. Intentionally blank.
SOLANA_PRIVATE_KEY=